{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": {
    "command": "node --test \"test/unit/**/*.test.ts\" \"test/store/**/*.test.ts\""
  },
  "mutate": [
    "src/store/**/*.ts",
    "src/schema/**/*.ts",
    "src/merge/field-merge.ts",
    "src/merge/conflict.ts",
    "src/render/**/*.ts"
  ],
  "coverageAnalysis": "off",
  "timeoutMS": 60000,
  "thresholds": {
    "high": 85,
    "low": 75,
    "break": 70
  }
}
