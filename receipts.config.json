{
  "version": 1,
  "claim": {
    "issue_link": "closes #(\\d+)",
    "downgrade_tags": [
      "unverified-reasoned",
      "speculative",
      "reverted"
    ]
  },
  "build": {
    "sha_source": "none",
    "platform": "none"
  },
  "verify": {
    "test_command": "node --test {test}",
    "suite_command": "npm test",
    "require_fresh_base": "warn",
    "live_drive": null,
    "on_load_error_red": "warn"
  },
  "degrade": {
    "on_no_receipt": "require-downgrade-tag",
    "on_unreachable_build": "sha-bind-only"
  },
  "gates": {
    "medium": "library",
    "enabled": "all",
    "G6": {
      "mode": "warn"
    },
    "G7": {
      "mode": "warn"
    },
    "G8": {
      "integration_branch": "main"
    },
    "G10": {
      "mode": "warn"
    },
    "G11": {
      "mode": "block"
    },
    "G12": {
      "mode": "warn"
    },
    "G13": {
      "mode": "warn"
    },
    "G14": {
      "mode": "warn"
    }
  }
}
