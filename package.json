{
  "name": "logbook",
  "version": "0.2.8",
  "private": true,
  "type": "module",
  "description": "Git-native, multi-user, drift-aware logbook plugin for Claude Code.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "rebuild:typecheck": "tsc -p rebuild/tsconfig.json --noEmit",
    "prerebuild:test": "npm run rebuild:build",
    "rebuild:test": "node --test \"rebuild/test/unit/**/*.test.ts\" \"rebuild/test/store/**/*.test.ts\" \"rebuild/test/contract/**/*.test.ts\" \"rebuild/test/sync/**/*.test.ts\" \"rebuild/test/spawn/**/*.test.ts\" \"rebuild/test/hooks/**/*.test.ts\"",
    "rebuild:build": "tsc -p rebuild/tsconfig.json && chmod +x rebuild/dist/bin/*.js",
    "rebuild:inspect": "mcp-inspector --config rebuild/inspector.config.json --server logbook",
    "rebuild:inspect:cli": "mcp-inspector --cli --config rebuild/inspector.config.json --server logbook --method tools/list",
    "rebuild:mutate": "stryker run rebuild/stryker.config.json",
    "rebuild:coverage": "node --experimental-test-coverage --test \"rebuild/test/unit/**/*.test.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "ulid": "3.0.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "2.3.0",
    "@stryker-mutator/core": "10.0.0",
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  }
}
