{
  "name": "logbook",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "description": "Git-native, multi-user, drift-aware logbook plugin for Claude Code.",
  "author": "Satanshu Mishra <satanshumishra@outlook.com>",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "test": "node --test \"test/unit/**/*.test.ts\" \"test/store/**/*.test.ts\" \"test/contract/**/*.test.ts\" \"test/sync/**/*.test.ts\" \"test/spawn/**/*.test.ts\" \"test/hooks/**/*.test.ts\"",
    "prepare": "node scripts/install-githooks.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "inspect": "mcp-inspector --config inspector.config.json --server logbook",
    "inspect:cli": "mcp-inspector --cli --config inspector.config.json --server logbook --method tools/list"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "ulid": "3.0.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "2.3.0",
    "@types/node": "22.20.1",
    "commonmark": "0.31.2",
    "typescript": "5.9.3",
    "yaml": "^2.9.0"
  }
}
