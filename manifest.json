{"schemaVersion":1,"logicalRunId":"31c7c3d8","spec":"docs/specs/2026-08-02-preflight-briefing-redesign.md","baseBranch":"feat/preflight-briefing","sourcePrefix":"preflight","specContentHash":"812f1c1021b97462d3b9bf1704a84f3284095c246dd1ed2953fb3a43e4b83c2b","clusters":[["read-decision-tool","require-open-criteria","criterion-identity-v2","scoped-spine-items","server-rendered-briefing","progress-index-counts","briefing-verbatim-gate","criteria-amendments","drift-since-you-left","roster-progress-line"]],"msps":[{"id":"read-decision-tool","dependsOn":[],"fileScope":["src/tools/read-decision.mjs","src/tools/registry.mjs","test/unit/tools/read-decision.test.mjs","test/unit/tools/registry.test.mjs","test/unit/server/entrypoint.test.mjs"],"changeType":"feat","scope":"tools","title":"register the read_decision tool","rationale":"The briefing's NOT SHOWN section promises a decision drill-down, and driver.readDecision has existed unregistered at local-driver.mjs:213 with nothing in registry.mjs exposing it."},{"id":"require-open-criteria","dependsOn":[],"fileScope":["src/tools/open-thread.mjs","test/e2e/branch-reattach.test.mjs","test/e2e/drift-signals.test.mjs","test/e2e/fsm-dod.test.mjs","test/e2e/handoff-chain.test.mjs","test/e2e/harness-smoke.test.mjs","test/e2e/non-git-parity.test.mjs","test/e2e/resume-substrate.test.mjs","test/unit/cli/record-sha.test.mjs","test/unit/cli/restore.test.mjs","test/unit/cli/roster.test.mjs","test/unit/server/create-server.test.mjs","test/unit/server/entrypoint.test.mjs","test/unit/tools/append-session-event.test.mjs","test/unit/tools/archive-thread.test.mjs","test/unit/tools/bind-branch.test.mjs","test/unit/tools/create-successor.test.mjs","test/unit/tools/get-resume-brief.test.mjs","test/unit/tools/open-thread.test.mjs","test/unit/tools/rebuild-index.test.mjs","test/unit/tools/record-decision.test.mjs","test/unit/tools/registry.test.mjs","test/unit/tools/reopen.test.mjs","test/unit/tools/transition-thread.test.mjs","test/unit/tools/update-thread.test.mjs"],"changeType":"feat","scope":"threads","title":"require criteria to open a thread","rationale":"A thread opened with no definition of done cannot render progress, and open-thread.mjs:36 permits exactly that today (audit finding 4)."},{"id":"criterion-identity-v2","dependsOn":["require-open-criteria"],"fileScope":["src/schema/thread.schema.mjs","src/schema/thread-v1.schema.mjs","src/schema/upcast.mjs","src/schema/validators.mjs","src/schema/index.mjs","src/model/thread.mjs","src/drivers/local-driver.mjs","src/tools/schemas.mjs","src/tools/open-thread.mjs","src/tools/update-thread.mjs","src/tools/create-successor.mjs","skills/debrief/SKILL.md","test/unit/schema/thread-schema.test.mjs","test/unit/schema/upcast.test.mjs","test/unit/schema/index.test.mjs","test/unit/model/thread.test.mjs","test/unit/tools/open-thread.test.mjs","test/unit/tools/update-thread.test.mjs","test/unit/tools/create-successor.test.mjs","test/unit/tools/transition-thread.test.mjs","test/unit/drivers/local-driver.test.mjs","test/unit/drivers/git-ref-driver.test.mjs","test/e2e/fsm-dod.test.mjs"],"changeType":"feat","scope":"schema","title":"give completion criteria stable ids","rationale":"Text-matched criteria cannot carry a scope, a detour kind or a strike, so every later part of the redesign depends on criterion ids landing first (decision 0018)."},{"id":"scoped-spine-items","dependsOn":["criterion-identity-v2"],"fileScope":["src/schema/thread.schema.mjs","src/schema/upcast.mjs","src/model/caps.mjs","src/model/selection.mjs","src/model/index.mjs","src/model/thread.mjs","src/tools/schemas.mjs","src/tools/update-thread.mjs","src/tools/record-decision.mjs","src/tools/transition-thread.mjs","src/tools/archive-thread.mjs","src/tools/reopen.mjs","skills/debrief/SKILL.md","test/unit/model/selection.test.mjs","test/unit/model/caps.test.mjs","test/unit/model/index.test.mjs","test/unit/model/thread.test.mjs","test/unit/schema/thread-schema.test.mjs","test/unit/schema/upcast.test.mjs","test/unit/schema/index.test.mjs","test/unit/tools/update-thread.test.mjs","test/unit/tools/record-decision.test.mjs","test/unit/tools/transition-thread.test.mjs","test/unit/tools/archive-thread.test.mjs","test/unit/tools/reopen.test.mjs","test/unit/drivers/local-driver.test.mjs","test/unit/drivers/git-ref-driver.test.mjs","test/e2e/handoff-chain.test.mjs"],"changeType":"feat","scope":"spine","title":"scope spine risks and decisions","rationale":"A briefing filtered by the current step needs risks and decisions that declare which step they belong to, and today both are opaque strings with no axis to filter on."},{"id":"server-rendered-briefing","dependsOn":["scoped-spine-items","read-decision-tool"],"fileScope":["src/render/briefing.mjs","src/tools/get-resume-brief.mjs","skills/preflight/SKILL.md","test/unit/render/briefing.test.mjs","test/unit/skills/preflight.test.mjs","test/unit/tools/get-resume-brief.test.mjs","test/e2e/branch-reattach.test.mjs","test/e2e/handoff-chain.test.mjs","test/e2e/non-git-parity.test.mjs","test/e2e/resume-substrate.test.mjs"],"changeType":"feat","scope":"briefing","title":"render the briefing on the server","rationale":"The model renders the briefing from JSON today, so its format differs every run and its size tracks the thread's age rather than the step being worked."},{"id":"briefing-verbatim-gate","dependsOn":["server-rendered-briefing"],"fileScope":["src/tools/get-resume-brief.mjs","src/drivers/storage-driver.mjs","src/drivers/local-driver.mjs","bin/ledger-cli.mjs","hooks/lib/stop.mjs","test/unit/tools/get-resume-brief.test.mjs","test/unit/drivers/storage-driver.test.mjs","test/unit/drivers/local-driver.test.mjs","test/unit/cli/briefing-pledge.test.mjs","test/unit/hooks/stop.test.mjs"],"changeType":"feat","scope":"hooks","title":"gate the turn on a verbatim briefing","rationale":"A renderer creates a canonical string but does not make the model emit it, and nothing today compares what the model wrote to what the server produced (decision 0020)."},{"id":"criteria-amendments","dependsOn":["server-rendered-briefing"],"fileScope":["src/tools/amend-criteria.mjs","src/tools/registry.mjs","src/tools/schemas.mjs","src/model/dod.mjs","src/drift/disposition.mjs","skills/debrief/SKILL.md","test/unit/tools/amend-criteria.test.mjs","test/unit/tools/registry.test.mjs","test/unit/server/entrypoint.test.mjs","test/unit/model/dod.test.mjs","test/unit/drift/disposition.test.mjs","test/unit/skills/debrief.test.mjs","test/e2e/thread-lifecycle.test.mjs"],"changeType":"feat","scope":"tools","title":"add amend_criteria for plan changes","rationale":"Unplanned work and wrong plans have no tool, so criteria drift silently and the done fraction moves with no record explaining it (decisions 0008, 0009)."},{"id":"drift-since-you-left","dependsOn":["server-rendered-briefing"],"fileScope":["src/tools/reconcile.mjs","src/tools/get-resume-brief.mjs","test/unit/tools/reconcile.test.mjs","test/unit/tools/get-resume-brief.test.mjs","test/e2e/drift-signals.test.mjs"],"changeType":"feat","scope":"drift","title":"snapshot drift for the briefing","rationale":"Reconcile closes merged and orphaned bindings before the briefing runs, so drift cannot be recomputed at read time and must be persisted as a snapshot instead."},{"id":"progress-index-counts","dependsOn":["scoped-spine-items"],"fileScope":["src/index/rebuild-index.mjs","test/unit/index/rebuild-index.test.mjs","test/unit/tools/rebuild-index.test.mjs","test/unit/cli/roster.test.mjs"],"changeType":"feat","scope":"index","title":"add progress counts to the index","rationale":"The resumable index carries no progress, so how far along a thread is cannot be answered without opening the thread record itself."},{"id":"roster-progress-line","dependsOn":["progress-index-counts"],"fileScope":["hooks/lib/roster.mjs","test/unit/hooks/roster.test.mjs"],"changeType":"feat","scope":"roster","title":"show thread progress in the roster","rationale":"The roster line at roster.mjs:11 prints the whole next step, up to 500 chars per thread, and shows no progress at all."}]}